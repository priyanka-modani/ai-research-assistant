MODEL_PROVIDER=nebius

NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Choose an available Text-to-Text model from scripts/list_nebius_models.py
NEBIUS_CHAT_MODEL=meta-llama/Llama-3.3-70B-Instruct
# Choose an available Embedding model
NEBIUS_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# Rerank uses the separate /v1/rerank endpoint
NEBIUS_RERANK_MODEL=Qwen/Qwen3-Reranker-8B
# Enable only after scripts/smoke_test_providers.py confirms /v1/rerank access.
ENABLE_RERANK=false

# The LlamaParse key is the LlamaCloud project-scoped key (usually starts llx-)
LLAMA_CLOUD_API_KEY=
USE_LLAMAPARSE=true
LLAMAPARSE_TIER=agentic

# Optional provider and stretch memory
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=
MEM0_API_KEY=

CHROMA_PATH=storage/chroma
CHROMA_COLLECTION=connecttel_research_assistant
CHUNKS_PATH=storage/chunks.json
TOP_K_DENSE=8
TOP_K_SPARSE=8
TOP_K_FINAL=5
MIN_EVIDENCE_COUNT=1
